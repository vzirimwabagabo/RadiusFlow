# RadiusFlow Backend Environment Configuration
# Copy this file to .env on your VPS and fill in real secrets.
# Never commit .env to version control.

# --- Database ---
# Use the radiusflow_app role (NOT postgres superuser or runtime radius role).
DATABASE_URL=postgresql+psycopg2://radiusflow_app:YOUR_REAL_DB_PASSWORD@localhost:5432/radius

# --- JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=YOUR_REAL_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
AUTH_SESSION_HOURS=12

# --- CORS & Security ---
# Comma-separated allowed origins (e.g. your domain or IP). Do NOT use '*' in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-domain.com
SESSION_COOKIE_SECURE=true
ENVIRONMENT=production

# --- Payment Gateway (M-Pesa / Stripe / Gateway API) ---
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_API_SECRET=your_payment_api_secret_here
PAYMENT_PROVIDER_URL=https://api.paymentprovider.com/v1
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret

# --- SMS & Notifications (optional) ---
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=RADIUSFLOW

# --- Server Bind Settings ---
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
